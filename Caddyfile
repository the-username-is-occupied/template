{
    auto_https off
}


(site) {
    encode zstd gzip
    root * /var/www/html/public

    mercure {
        transport_url {$MERCURE_TRANSPORT_URL:bolt:///data/mercure.db}
        publisher_jwt {$MERCURE_JWT_SECRET:!ChangeThisMercureHubJWTSecretKey!} HS256
        subscriber_jwt {$MERCURE_JWT_SECRET:!ChangeThisMercureHubJWTSecretKey!} HS256
        anonymous
        subscriptions
    }

    @static {
        file
        path /build/* /assets/* /storage/* *.ico *.css *.js *.gif *.jpg *.jpeg *.png *.svg *.webp *.avif *.woff *.woff2 *.ttf
    }
    handle @static {
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # Serve PHP via FrankenPHP (includes file_server and try_files internally)
    php_server

    # Basic security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

:80 {
    import site
}

