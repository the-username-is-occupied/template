## Streaming

```php
use App\Ai\Agents\SalesCoach;
use Laravel\Ai\Responses\StreamedAgentResponse;

// Вернуть SSE-стрим из роута
Route::get('/coach', fn () => (new SalesCoach)->stream('Analyze...'));

// С колбэком по завершении
Route::get('/coach', function () {
    return (new SalesCoach)
        ->stream('Analyze...')
        ->then(function (StreamedAgentResponse $response) {
            // $response->text, $response->events, $response->usage
        });
});

// Ручная итерация
$stream = (new SalesCoach)->stream('Analyze...');
foreach ($stream as $event) { /* ... */ }

// Vercel AI SDK Protocol
return (new SalesCoach)->stream('Analyze...')->usingVercelDataProtocol();
```

