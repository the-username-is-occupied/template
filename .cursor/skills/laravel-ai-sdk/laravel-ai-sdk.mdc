## Векторные хранилища (Vector Stores)

```php
use Laravel\Ai\Stores;
use Laravel\Ai\Files\Document;

// Создать хранилище
$store = Stores::create('Knowledge Base');
$store = Stores::create(
    name: 'Knowledge Base',
    description: 'Documentation materials.',
    expiresWhenIdleFor: days(30),
);
$storeId = $store->id;

// Получить хранилище
$store = Stores::get('store_id');
$store->id; $store->name; $store->fileCounts; $store->ready;

// Удалить
Stores::delete('store_id');
$store->delete();

// Добавить файлы
$doc = $store->add('file_id');
$doc = $store->add(Document::fromId('file_id'));
$doc = $store->add(Document::fromPath('/path/to/doc.pdf'));
$doc = $store->add(Document::fromStorage('manual.pdf'));
$doc = $store->add($request->file('document'));

// С метаданными (для фильтрации через FileSearch)
$store->add(Document::fromPath('/report.pdf'), metadata: [
    'author' => 'Taylor Otwell',
    'department' => 'Engineering',
    'year' => 2026,
]);

// Удалить файл из хранилища
$store->remove('file_id');
$store->remove('file_id', deleteFile: true); // удалить и из file storage
```

